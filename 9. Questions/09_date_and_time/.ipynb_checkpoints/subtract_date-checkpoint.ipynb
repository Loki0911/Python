   "source": [
    "#  Write a Python program to subtract five days from current date"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "73ce5835-4e29-4d57-a8ab-589b1ca03c57",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "current date :  2025-09-26\n",
      "5 days  earlier :  2025-09-21\n"
     ]
    }
   ],
   "source": [
    "from datetime import date,timedelta\n",
    "td=date.today()-timedelta(5)\n",
    "print(\"current date : \",date.today())\n",
    "print(\"5 days  earlier : \",td)"
   ]
