   "outputs": [],
   "source": [
    "# Write a Python program to check whether an alphabet is a vowel or consonant"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "8a20db16-3eba-465c-ab87-3b3b303d57f3",
   "metadata": {},
   "outputs": [
    {
     "name": "stdin",
     "output_type": "stream",
     "text": [
      "Enter the letter of an alphabet:  d\n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "d is consonant letter\n"
     ]
    }
   ],
   "source": [
    "l=input(\"Enter the letter of an alphabet: \")\n",
    "if l in ('a' , 'e' , 'i' , 'o' , 'u'):\n",
    "    print(\"%s is vowel letter\" % l)\n",
    "else:\n",
    "        print(\"%s is consonant letter\" % l)"
   ]
