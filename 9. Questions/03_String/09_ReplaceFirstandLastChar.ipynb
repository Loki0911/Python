   "source": [
    "#  Write a Python program to change a given string to a new string where the first and last chars have been exchanged\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "98719c93-fa05-4cc8-bec3-193111f3fc93",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "ftafs\n"
     ]
    }
   ],
   "source": [
    "def change_char(str1):\n",
    "    return str1[-1:]+str1[1:-1]+str1[:1]\n",
    "print(change_char(\"staff\"))"
   ]
