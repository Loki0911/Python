   "source": [
    "# Write a Python program to calculate the length of a string."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "9c9b2182-6918-4a60-b589-0543d7dffaf2",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "11\n"
     ]
    }
   ],
   "source": [
    "def string_len(str):\n",
    "    count=0\n",
    "    for char in str:\n",
    "        count+=1\n",
    "    return count\n",
    "print(string_len(\"hello world\"))"
   ]
