   "source": [
    "# Write a Python program to calculate the sum of a list of numbers. (in recursion fashion)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "4c8b3ea8-0426-42b7-8984-c81d60b6da1e",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "24\n"
     ]
    }
   ],
   "source": [
    "def sum_of_list(list1):\n",
    "    if len(list1)==1:\n",
    "        return list1[0]\n",
    "    else:\n",
    "        return list1[0]+sum_of_list(list1[1:])\n",
    "\n",
    "print(sum_of_list([2, 4, 5, 6, 7]))"
   ]
  },
