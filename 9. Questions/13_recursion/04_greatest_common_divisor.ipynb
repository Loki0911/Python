   "source": [
    "# Write a Python program to find the greatest common divisor (gcd) of two integers."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "4f0e8fc8-dc4a-42bb-b2d6-7425f58999b8",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "14\n"
     ]
    }
   ],
   "source": [
    "def Recgcd(a,b):\n",
    "    if b==0:\n",
    "        return a\n",
    "    else:\n",
    "        return Recgcd(b,a%b)\n",
    "print(Recgcd(0,14))"
   ]
