   "source": [
    "# Write a Python program to flip a coin 1000 times and count heads and tails."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "91a61ca6-fd0c-4a1c-b4ee-2be10f302901",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Heads =  480\n",
      "Tails =  520\n"
     ]
    }
   ],
   "source": [
    "import random\n",
    "result={'head':0,'tail':0}\n",
    "side=list(result.keys())\n",
    "\n",
    "for i in range(1000):\n",
    "    result[random.choice(side)]+=1\n",
    "print(\"Heads = \",result['head'])\n",
    "print(\"Tails = \",result['tail'])"
   ]
  },
