   "source": [
    "# Write a Python program to sum all the items in a list\n",
    "# Example sum_list([1,2,-8])\n",
    "# Return -5\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "7dcf0546-7ff0-4a6d-8ca3-0da76f37b69f",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "-5\n"
     ]
    }
   ],
   "source": [
    "def sum_num(items):\n",
    "    sum=0\n",
    "    for num in items:\n",
    "        sum+=num\n",
    "    return sum\n",
    "print(sum_num([1,2,-8]))"
   ]
  },
