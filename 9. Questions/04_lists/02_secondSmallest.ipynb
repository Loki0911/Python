   "source": [
    "# Write a Python program to find the second smallest number in a list.\n",
    "# input\n",
    "# second_smallest([1, 2, -8, -2, 0])\n",
    "# output\n",
    "# -2\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "34f9bc29-e048-4f9b-a28e-e103fa4c2032",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "-2\n"
     ]
    }
   ],
   "source": [
    "def second_smallest(items):\n",
    "    sorted_items=sorted(items)\n",
    "    return sorted_items[1]\n",
    "print(second_smallest([1,2,-8,-2,0]))\n",
    "    "
   ]
