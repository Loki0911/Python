   "source": [
    "# Write a Python program to get the largest number from a list.\n",
    "# max_num_in_list([1, 2, -8, 0])\n",
    "# return 2"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "f1585ad5-f325-4cdd-881a-20c5dfd1574d",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "2\n"
     ]
    }
   ],
   "source": [
    "def find_max(items):\n",
    "    max_num=items[0]\n",
    "    for a in items:\n",
    "        if a>max_num:\n",
    "            max_num=a\n",
    "    return max_num\n",
    "\n",
    "print(find_max([1, 2, -8, 0]))"
   ]
  },
