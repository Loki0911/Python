   "source": [
    "# Write a Python program to get the file size of a plain file.\n",
    "# Use test.txt file at same folder\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "67b6afc5-260b-4921-8584-c0dd34decce3",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "File size in bytes of plain files = 763\n"
     ]
    }
   ],
   "source": [
    "import os\n",
    "def file_size(fname):\n",
    "    statinfo=os.stat(fname)\n",
    "    return statinfo.st_size\n",
    "print(\"File size in bytes of plain files =\",file_size('test.txt'))"
   ]
  },
