   "source": [
    "# Write a Python class to reverse a string word by word.\n",
    "# Input \"hello world\"\n",
    "# Output \"world hello\""
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "47a81208-3a7b-44c9-80df-5f6a423554cd",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "world hello\n"
     ]
    }
   ],
   "source": [
    "class reverse_word:\n",
    "    def rev(self,str1):\n",
    "        return ' '.join(reversed(str1.split()))\n",
    "print(reverse_word().rev(\"hello world\"))"
   ]
  },
